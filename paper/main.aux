\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Share of $k$-run subsets of the observed 32 runs (C07) that include a run reaching the best known value, $1-\binom  {32-s}{k}/\binom  {32}{k}$ for $s$ successful runs, on six instances where the gradient paths differ. This is a without-replacement estimate from one pool; it is 1 at $k=32$ whenever $s>0$. Runs not selected for tightening count with their legalised size.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:bestofk}{{3}{9}{Share of $k$-run subsets of the observed 32 runs (C07) that include a run reaching the best known value, $1-\binom {32-s}{k}/\binom {32}{k}$ for $s$ successful runs, on six instances where the gradient paths differ. This is a without-replacement estimate from one pool; it is 1 at $k=32$ whenever $s>0$. Runs not selected for tightening count with their legalised size}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Which part of hardening matters (C11, C12; harden and rigid from C07, same seeds, settings and budget). Each cell $a:b$ counts the instances on which the first method\textquotesingle s lowest size is lower than the second\textquotesingle s, and the reverse; the rest are ties. \emph  {snap} compresses disks as hardening does, then switches to polygons at once; \emph  {grow-area} keeps rigid polygons whose area follows hardening\textquotesingle s.}}{9}{table.4}\protected@file@percent }
\newlabel{tab:ablate}{{4}{9}{Which part of hardening matters (C11, C12; harden and rigid from C07, same seeds, settings and budget). Each cell $a:b$ counts the instances on which the first method\textquotesingle s lowest size is lower than the second\textquotesingle s, and the reverse; the rest are ties. \emph {snap} compresses disks as hardening does, then switches to polygons at once; \emph {grow-area} keeps rigid polygons whose area follows hardening\textquotesingle s}{table.4}{}}
\@writefile{toc}{\contentsline {paragraph}{What the pieces do.}{9}{section*.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces What pieces do after compression, on the best run of each C07 instance with $n\ge 6$ (orange: hardening; blue: rigid; large dots: the method alone reached the lowest size). Left: mean distance moved; middle: mean rotation, modulo the piece's symmetry (for hardening this includes turning while pieces are still nearly round and orientation costs almost nothing); right: share of pieces with no edge within $2^\circ $ of a container edge (square and triangle containers).}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:mechanism}{{4}{10}{What pieces do after compression, on the best run of each C07 instance with $n\ge 6$ (orange: hardening; blue: rigid; large dots: the method alone reached the lowest size). Left: mean distance moved; middle: mean rotation, modulo the piece's symmetry (for hardening this includes turning while pieces are still nearly round and orientation costs almost nothing); right: share of pieces with no edge within $2^\circ $ of a container edge (square and triangle containers)}{figure.4}{}}
